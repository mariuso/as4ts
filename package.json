{
  "name": "as4ts",
  "version": "0.2.0-rc.2",
  "description": "Peppol AS4 messaging in TypeScript: one-shot AS4 sending plus optional SML/SMP participant lookup. Each call performs exactly one operation and reports facts.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariuso/as4ts.git"
  },
  "bugs": {
    "url": "https://github.com/mariuso/as4ts/issues"
  },
  "homepage": "https://github.com/mariuso/as4ts#readme",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./certificate-validator": {
      "types": "./dist/certificate-validator.d.ts",
      "import": "./dist/certificate-validator.js"
    },
    "./classifier": {
      "types": "./dist/classifier.d.ts",
      "import": "./dist/classifier.js"
    },
    "./lookup": {
      "types": "./dist/lookup/index.d.ts",
      "import": "./dist/lookup/index.js"
    },
    "./receive": {
      "types": "./dist/receive/index.d.ts",
      "import": "./dist/receive/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "version": "node scripts/sync-version.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "audit": "npm audit --omit=dev --audit-level=high",
    "examples:send": "node --import tsx examples/send-one.ts",
    "examples:smp": "node --import tsx examples/smp-lookup.ts",
    "examples:receive": "node --import tsx examples/receive-inbox.ts",
    "examples:record-smp": "node --import tsx examples/record-smp.ts",
    "selftest": "node --import tsx examples/local-selftest.ts",
    "validate:receive": "node --import tsx test/validate-receive.ts",
    "measure:receive": "node --import tsx test/measure-receive.ts",
    "make-invoice": "node --import tsx examples/make-bis-invoice.ts",
    "trust:update": "node --import tsx examples/update-trust.ts"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.15",
    "saxes": "^6.0.0",
    "xml-crypto": "^6.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "asn1js": "^3.0.10",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "pkijs": "^3.4.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "peppol",
    "as4",
    "ebms3",
    "e-delivery",
    "edelivery",
    "ubl",
    "invoice",
    "typescript",
    "sbdh",
    "messaging"
  ]
}
